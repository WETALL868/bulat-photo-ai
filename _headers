# Файлы с неизменным содержимым держим в кеше год.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Каталог и цены проверяем на каждый заход: цены обновляются по расписанию.
/data/*
  Cache-Control: no-cache, must-revalidate
/live/*
  Cache-Control: no-cache, must-revalidate

# Служебные разделы витрины не индексируются.
/cart
  X-Robots-Tag: noindex, nofollow
/checkout
  X-Robots-Tag: noindex, nofollow
/order/*
  X-Robots-Tag: noindex, nofollow
/favorites
  X-Robots-Tag: noindex, nofollow
/compare
  X-Robots-Tag: noindex, nofollow
/login
  X-Robots-Tag: noindex, nofollow
/search
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
